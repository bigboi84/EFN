{
  "name": "efn-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "tsc -b && SINGLE=1 vite build",
    "build:offline": "python3 scripts/build_offline.py",
    "dev:arena": "vite --config vite.arena.config.ts",
    "build:arena": "tsc -b && vite build --config vite.arena.config.ts",
    "build:arena:single": "tsc -b && SINGLE=1 vite build --config vite.arena.config.ts",
    "build:arena:offline": "python3 scripts/build_offline.py --site arena"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
